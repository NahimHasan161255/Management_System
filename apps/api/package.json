{
  "name": "@hsms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "migrate:up": "node-pg-migrate up --envPath .env --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --envPath .env --migrations-dir migrations"
  },
  "dependencies": {
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "node-pg-migrate": "^9.0.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
