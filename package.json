{
  "name": "japan-higher-study-management-system",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @hsms/api",
    "dev:web": "npm run dev --workspace @hsms/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  }
}
